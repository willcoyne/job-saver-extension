{
  "manifest_version": 3,
  "name": "Quick Job Saver",
  "version": "1.2",
  "description": "Scrapes job postings and pushes to Google Sheets",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.joinhandshake.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}